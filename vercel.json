{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "functions": {
    "api/ask-pip.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 5
    },
    "api/progress.js": {
      "maxDuration": 10
    },
    "api/flag.js": {
      "maxDuration": 10
    },
    "api/friends.js": {
      "maxDuration": 10
    }
  }
}
